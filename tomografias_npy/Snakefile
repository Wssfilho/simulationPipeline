from snakemake.exceptions import WorkflowError

configfile: "config.yaml"
#caso precise podemos usar mais de 3 vezes os benchmarks basta usar o repeat
samples_from_npy = glob_wildcards("{sample}.npy").sample
samples_from_nii = glob_wildcards("imagens_ct/{sample}.nii.gz").sample
samples = sorted(set(samples_from_npy + samples_from_nii))
samples_for_mhd = sorted(set(samples_from_npy))
spacing = config.get("spacing", [])
gate_inicio = config.get("gate_inicio", 0)
center_mhd = config.get("center_mhd", False)
origin_mhd = config.get("origin_mhd", None)

if len(spacing) != 3:
    raise WorkflowError(
        "config.yaml deve conter spacing com 3 valores: [SX, SY, SZ]."
    )

if not samples:
    raise WorkflowError(
        "Nenhuma entrada encontrada. Coloque arquivos .npy na pasta atual "
        "ou arquivos .nii.gz em imagens_ct/."
    )

if origin_mhd is not None:
    if len(origin_mhd) != 3:
        raise WorkflowError(
            "config.yaml deve conter origin_mhd com 3 valores: [OX, OY, OZ]."
        )
    if center_mhd:
        raise WorkflowError(
            "Use apenas um: origin_mhd ou center_mhd=true."
        )

rule all:
    input:
        expand("resultados/{sample}.nii", sample=samples),
        # expand("output/Slide-{sample}.mhd", sample=samples_for_mhd),
        # expand("output/stat-{sample}.txt", sample=samples_for_mhd),
        # "output/Dose-total.mhd",
        # "output/Edep-total.mhd",
        "resultados_dvh/estatisticas_dose_por_orgao.csv",
        "resultados_dvh/dvh_todos_orgaos_estilo_classico.png",
        "resultados_dvh/dvh_todos_orgaos.csv",
        directory("resultados_dvh/mascaras_binarias")

rule convert_npy_to_nii:
    input:
        "{sample}.npy"
    output:
        "imagens_ct/{sample}.nii.gz"
    params:
        spacing=lambda wc: " ".join(map(str, spacing)),
        origin_flag=lambda wc: f"--origin {' '.join(map(str, origin_mhd))}" if origin_mhd else "",
        center_flag="--center" if center_mhd else ""
    message:
        "Convertendo {input} para {output}"
    benchmark:
        "benchmarks/convert_npy_to_nii/{sample}.tsv"
    shell:
        """
        python npy2nii.py {input} --output {output} --spacing {params.spacing} --lps {params.center_flag} {params.origin_flag}
        """

rule convert_npy_to_mhd:
    input:
        "{sample}.npy"
    output:
        "../tomografias_npy/data/{sample}.mhd"
    params:
        spacing=lambda wc: " ".join(map(str, spacing)),
        origin_flag=lambda wc: f"--origin {' '.join(map(str, origin_mhd))}" if origin_mhd else "",
        center_flag="--center" if center_mhd else ""
    message:
        "Convertendo {input} para {output}"
    benchmark:
        "benchmarks/convert_npy_to_mhd/{sample}.tsv"
    shell:
        """
        python npy2mhd.py {input} --output {output} --spacing {params.spacing} {params.center_flag} {params.origin_flag}
        """
    

rule segment_with_totalsegmentator:
    input:
        "imagens_ct/{sample}.nii.gz"
    output:
        "resultados/{sample}.nii"
    message:
        "Segmentando {input} em {output}"
    benchmark:
        "benchmarks/segment_with_totalsegmentator/{sample}.tsv"
    shell:
        """
        python segmentation.py "{input}" --output "{output}"
        """

rule simulateGate:
    input:
        mhd=rules.convert_npy_to_mhd.output,
        seg="resultados/{sample}.nii"
    output:
        dose="output/Dose-{sample}.mhd",
        edep="output/Edep-{sample}.mhd",
        stats="output/stat-{sample}.txt"
    params:
        inicio=gate_inicio,
        image_rel=lambda wc, input: input.mhd,
        output_dir="../tomografias_npy/output/",
        tag=lambda wc: wc.sample
    message:
        "Simulando {input.mhd}"
    benchmark:
        "benchmarks/gate/{sample}.tsv"

    shell:
        """
        cd ../gate-first-simulator
        python ../tomografias_npy/minDetec_DT.py {params.inicio} --image "{params.image_rel}" --output-dir "{params.output_dir}" --tag "{params.tag}"
        """

rule sumResults:
    input:
        dose=expand("output/Dose-{sample}.mhd", sample=samples_for_mhd),
        edep=expand("output/Edep-{sample}.mhd", sample=samples_for_mhd),
        stats=expand("output/stat-{sample}.txt", sample=samples_for_mhd)
    output:
        dose="output/Dose-total.mhd",
        edep="output/Edep-total.mhd"
    message:
        "Somando resultados de dose/edep em output/"
    benchmark:
        "benchmarks/sumResults/total.tsv"
    shell:
        """
        python sumResults.py
        """

rule calculateDoses:
    input:
        seg="resultados/0801_clean_fdk_256.nii",
        dose="output/Dose-total.mhd"
    output:
        stats="resultados_dvh/estatisticas_dose_por_orgao.csv",
        dvh_all_png="resultados_dvh/dvh_todos_orgaos_estilo_classico.png",
        dvh_all_csv="resultados_dvh/dvh_todos_orgaos.csv",
        masks=directory("resultados_dvh/mascaras_binarias")
    message:
        "Gerando DVH a partir de calculateDoses.py"
    benchmark:
        "benchmarks/calculateDoses/total.tsv"
    shell:
        """
        ln -sf "{input.seg}" 0801_clean_fdk_256.nii
        ln -sf "{input.dose}" Dose-total.mhd
        python calculateDoses.py
        """
  